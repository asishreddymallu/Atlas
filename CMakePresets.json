{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "environment": {
                "PATH": "D:/Qt/Tools/mingw1310_64/bin;D:/Qt/6.9.2/mingw_64/bin;$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "D:/Qt/6.9.2/mingw_64/lib/cmake",
                "CMAKE_C_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/g++.exe"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "test",
            "displayName": "Test",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "ON",
                "ENABLE_COVERAGE": "OFF",
                "LOG_PANEL": "OFF",
                "DISABLE_GUI": "ON"
            }
        },
        {
            "name": "coverage",
            "displayName": "Test Coverage",
            "inherits": "test",
            "cacheVariables": {
                "ENABLE_COVERAGE": "ON"
            }
        },
        {
            "name": "cli",
            "displayName": "CLI",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF",
                "LOG_PANEL": "OFF",
                "DISABLE_GUI": "ON"

            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "description": "Linux: Ninja and the system's Qt 6 (found by CMake; no hard-coded path). Tested on Fedora 44.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-linux/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "linux-test",
            "displayName": "Linux Test",
            "description": "The test suite, configured as scripts/test.sh configures build-tests.",
            "inherits": "linux-base",
            "cacheVariables": {
                "ENABLE_TESTS": "ON",
                "DISABLE_GUI": "OFF"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "cli",
            "displayName": "Build CLI",
            "configurePreset": "cli",
            "targets": ["atlas_cli"]
        },
        {
            "name": "test",
            "configurePreset": "test",
            "targets": ["atlas_test"]
        },
         {
            "name": "test-only",
            "displayName": "Build tests (no coverage)",
            "configurePreset": "test",
            "targets": ["atlas_test"]
        },
        {
            "name": "test-coverage",
            "displayName": "Build tests (with coverage)",
            "configurePreset": "coverage",
            "environment": {
                "PATH": "D:/Qt/Tools/mingw1310_64/bin;D:/Qt/6.9.2/mingw_64/bin;$penv{PATH}"
            },
            "targets": ["atlas_test_cov"]
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-test",
            "displayName": "Linux Test (app, CLI and tests)",
            "configurePreset": "linux-test"
        }
    ],

    "testPresets": [
        {
            "name": "test",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "PATH": "D:/Qt/Tools/mingw1310_64/bin;D:/Qt/6.9.2/mingw_64/bin;$penv{PATH}"
            },
            "filter": {
                "exclude": {
                    "name": "^cov_"
                }
            }
        },
        {
            "name": "test-only",
            "displayName": "Run tests (no coverage)",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "PATH": "D:/Qt/Tools/mingw1310_64/bin;D:/Qt/6.9.2/mingw_64/bin;$penv{PATH}"
            },
            "filter": {
                "exclude": {
                    "name": "^cov_"
                }
            }
        },
        {
            "name": "test-coverage",
            "displayName": "Run tests (with coverage)",
            "configurePreset": "coverage",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "PATH": "D:/Qt/Tools/mingw1310_64/bin;D:/Qt/6.9.2/mingw_64/bin;$penv{PATH}"
            },
            "filter": {
                "include": {
                    "name": "^cov_"
                }
            }
        },
        {
            "name": "linux-test",
            "displayName": "Linux Test (serial)",
            "description": "Serial on purpose: the GUI tests share test/vm_state/temp.asm and flake in parallel (docs/TESTING.md).",
            "configurePreset": "linux-test",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 1
            }
        }
    ]
}