/* ── Kites theme template ──────────────────────────────────────────
 * Rendered by ThemeManager with a theme's JSON color tokens substituted
 * for the {{token}} placeholders below. Kept intentionally flat/minimal
 * (thin low-contrast borders, no gradients) to match a Zed-like aesthetic.
 * ───────────────────────────────────────────────────────────────── */

* {
    outline: 0;
}

QWidget {
    background-color: {{background}};
    color: {{foreground}};
    font-size: 13px;
    selection-background-color: {{selection}};
    selection-color: {{foreground}};
}

QMainWindow, QDialog {
    background-color: {{background}};
}

/* ── Sidebar / lists ───────────────────────────────────────────── */
QListWidget {
    background-color: {{surface}};
    border: none;
    border-right: 1px solid {{border}};
    outline: 0;
    padding: 8px 6px;   /* spacing scale */
}
QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 2px 0;
    color: {{mutedForeground}};
    /* 2px accent indicator, transparent until the item is current. Reserving
     * the space at rest means selecting an item cannot shift the label. */
    border-left: 2px solid transparent;
}
QListWidget::item:hover:!selected {
    background-color: {{currentLine}};
    color: {{foreground}};
}
QListWidget::item:selected {
    background-color: {{selection}};
    color: {{foreground}};
    border-left: 2px solid {{accent}};
}

/* ── Tab widgets ───────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid {{border}};
    background-color: {{background}};
}
QTabBar::tab {
    background-color: transparent;
    color: {{mutedForeground}};
    padding: 6px 14px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: {{foreground}};
    border-bottom: 2px solid {{accent}};
}
QTabBar::tab:hover:!selected {
    color: {{foreground}};
}

/* ── Buttons ───────────────────────────────────────────────────── */
QPushButton, QToolButton {
    background-color: {{surface}};
    color: {{foreground}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 5px 14px;
    min-height: 22px;
}
QPushButton:hover, QToolButton:hover {
    border-color: {{accent}};
}
QPushButton:pressed, QToolButton:pressed {
    background-color: {{selection}};
}
QPushButton:disabled, QToolButton:disabled {
    color: {{mutedForeground}};
    border-color: {{border}};
}
/* `* { outline: 0 }` at the top of this file removes Qt's default focus rect,
 * so keyboard focus has to be drawn explicitly. The accent clears 3:1 against
 * both background and surface in all four themes. */
QPushButton:focus, QToolButton:focus {
    border-color: {{accent}};
}

/* ── Segmented control ─────────────────────────────────────────
 * Checkable QPushButtons sharing a parent with autoExclusive, styled as one
 * joined pill. `segmented` marks membership; `segmentPos` rounds the outer
 * corners so the pair reads as a single control. */
QPushButton[segmented="true"] {
    background-color: transparent;
    color: {{mutedForeground}};
    border: 1px solid {{border}};
    border-radius: 0;
    padding: 3px 14px;
    min-height: 18px;
}
QPushButton[segmented="true"]:hover {
    color: {{foreground}};
    background-color: {{currentLine}};
}
QPushButton[segmented="true"]:checked {
    color: {{foreground}};
    background-color: {{selection}};
}
QPushButton[segmented="true"]:disabled {
    color: {{mutedForeground}};
    background-color: transparent;
}
QPushButton[segmentPos="first"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-right: none;
}
QPushButton[segmentPos="last"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* ── Text inputs / editors ────────────────────────────────────── */
QLineEdit {
    background-color: {{surface}};
    color: {{foreground}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: {{selection}};
}
QLineEdit:focus {
    border-color: {{accent}};
}
QComboBox {
    background-color: {{surface}};
    color: {{foreground}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}
QComboBox:focus, QComboBox:on {
    border-color: {{accent}};
}
QComboBox QAbstractItemView {
    background-color: {{surface}};
    border: 1px solid {{border}};
    selection-background-color: {{selection}};
    outline: 0;
}
/* editors sit flush against their panel, Zed-style: no frame.
 * palette() roles (not literal colors) so a per-widget palette set by
 * KitesEditor can express a separate editor theme. */
QTextEdit, QPlainTextEdit {
    background-color: palette(base);
    color: palette(text);
    border: none;
    selection-background-color: {{selection}};
}

/* ── Compiler output console border variants ─────────────────────
 * Toggled by objectName property set at runtime from AppSettings;
 * see compiler_tab.cpp. */
QPlainTextEdit#outputTextEdit[borderStyle="none"] {
    border: none;
}
QPlainTextEdit#outputTextEdit[borderStyle="subtle"] {
    border: 1px solid {{border}};
}
QPlainTextEdit#outputTextEdit[borderStyle="full"] {
    border: 2px solid {{accent}};
}

/* ── Pane titles ───────────────────────────────────────────────
 * Small muted caption above a pane, set via a `paneTitle` dynamic property in
 * the .ui files. Case is left to the string itself - QSS text-transform is not
 * relied on. */
QLabel[paneTitle="true"] {
    color: {{mutedForeground}};
    font-size: 11px;
    font-weight: 600;
    padding: 2px 0;
}

/* ── Menus / menu bar ──────────────────────────────────────────── */
QMenuBar {
    background-color: {{background}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 2px 4px;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
    background: transparent;
}
QMenuBar::item:selected {
    background-color: {{currentLine}};
}
QMenuBar::item:pressed {
    background-color: {{selection}};
}
QMenu {
    background-color: {{surface}};
    border: 1px solid {{border}};
    padding: 4px;
}
QMenu::item {
    padding: 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: {{selection}};
}
QMenu::item:disabled {
    color: {{mutedForeground}};
}
QMenu::separator {
    height: 1px;
    background-color: {{border}};
    margin: 4px 8px;
}

/* ── Tooltips ──────────────────────────────────────────────────── */
QToolTip {
    background-color: {{surface}};
    color: {{foreground}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px 8px;
}

/* ── Toolbars ──────────────────────────────────────────────────── */
QToolBar {
    background-color: {{background}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 6px 8px;   /* spacing scale: 8 outer, 6 vertical */
    spacing: 2px;
}
QToolBar::separator {
    background-color: {{border}};
    width: 1px;
    margin: 6px 8px;
}
/* Toolbar buttons are flat (Zed-style): no resting border or fill, state is
 * carried by the hover/pressed tint alone. More specific than the generic
 * QPushButton/QToolButton rule above so it wins there, without touching
 * QToolButtons elsewhere (e.g. the collapsible section headers). */
QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 20px;
}
QToolBar QToolButton:hover {
    background-color: {{currentLine}};
}
QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: {{selection}};
}
QToolBar QToolButton:disabled {
    color: {{mutedForeground}};
    background-color: transparent;
}

/* ── Ribbon ────────────────────────────────────────────────────
 * The ribbon's checkable buttons (the Editor/Expanded pair, the display-base
 * and cache-level pickers) mirror a widget inside the tab and have to show
 * which one is current. The rules above only reach a checked QToolButton
 * under a QToolBar, so without this a checked ribbon button draws exactly
 * like an unchecked one.
 *
 * The accent border is the indicator that carries the state: it clears 3:1
 * against the panel ground in all four themes, where the selection fill on
 * its own does not. The fill reinforces it and keeps {{foreground}} above
 * 4.5:1. Scoped by the panel's object name so no other QToolButton moves.
 * Stage 5 refines the look. */
#ribbonPanel QToolButton:checked {
    background-color: {{selection}};
    border: 1px solid {{accent}};
}

/* Small ribbon buttons stack in columns of two or three, so their height has
 * to come down to the icon plus a hairline - the generic button rule's 5 px
 * of vertical padding and 22 px min-height would need 115 px for a column of
 * three, in a panel band that is 69 px tall.
 *
 * Geometry only: no colour, no border, nothing the theme owns. Horizontal
 * padding is untouched. Deliberately not scoped to #ribbonPanel, so the
 * probe RibbonGroup measures the grid with is subject to the same rule as
 * the real buttons. */
QToolButton[ribbonStacked="true"] {
    padding-top: 1px;
    padding-bottom: 1px;
    min-height: 0px;
}

/* step-interval spinbox lives in the toolbar */
QSpinBox {
    background-color: {{surface}};
    color: {{foreground}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}
QSpinBox:focus {
    border-color: {{accent}};
}

/* ── Table / tree views ────────────────────────────────────────── */
/* Data tables carry dense numeric content. Structure comes from monospace
 * cells and column alignment (set by the models), not from gridlines, so the
 * grid is dropped and rows are separated by zebra striping instead. */
QTableView, QTreeView {
    background-color: {{surface}};
    alternate-background-color: {{currentLine}};
    color: {{foreground}};
    border: 1px solid {{border}};
    gridline-color: transparent;
    selection-background-color: {{selection}};
}
QTableView::item, QTreeView::item {
    padding: 4px 10px;   /* spacing scale -> ~24px compact rows */
    border: none;
}
QTableView::item:hover, QTreeView::item:hover {
    background-color: {{selection}};
}
QTableView::item:selected, QTreeView::item:selected {
    background-color: {{selection}};
    color: {{foreground}};
}
/* The header must not share the body's background or it stops reading as a
 * header. Small semibold muted text over the window background, with a 2px
 * rule under it - the one place a 2px border is allowed besides active-state
 * indicators. Header text case is left to headerData(); QSS text-transform is
 * not relied on. */
QHeaderView {
    background-color: {{background}};
}
QHeaderView::section {
    background-color: {{background}};
    color: {{mutedForeground}};
    padding: 6px 10px;
    border: none;
    border-bottom: 2px solid {{border}};
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover {
    color: {{foreground}};
}
QTableCornerButton::section {
    background-color: {{background}};
    border: none;
    border-bottom: 2px solid {{border}};
}

/* ── Scrollbars ────────────────────────────────────────────────── */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    margin: 0;
}
QScrollBar:vertical { width: 8px; }
QScrollBar:horizontal { height: 8px; }
QScrollBar::handle {
    background: {{border}};
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover {
    background: {{mutedForeground}};
}
QScrollBar::handle:pressed {
    background: {{accent}};
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0; height: 0;
}
/* without these the default trough paints through on some styles */
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── Splitters ─────────────────────────────────────────────────── */
/* width is pinned to 1px by AppStyle::pixelMetric(PM_SplitterWidth) */
QSplitter::handle {
    background-color: {{border}};
}
QSplitter::handle:hover {
    background-color: {{accent}};
}

/* ── Dock widgets (Problems) ───────────────────────────────────
 * The dock's table inherits the QTableView rules above, so only the frame,
 * title bar and empty state need styling here. */
QDockWidget {
    background-color: {{surface}};
    color: {{foreground}};
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background-color: {{background}};
    padding: 6px 10px;          /* spacing scale */
    border-top: 1px solid {{border}};
    border-bottom: 1px solid {{border}};
    text-align: left;
}
QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
    icon-size: 12px;
}
QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: {{currentLine}};
}
QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: {{selection}};
}

/* the "No problems" placeholder sits on the dock's surface */
QLabel#problemsEmptyState {
    color: {{mutedForeground}};
    font-size: 13px;
    background-color: {{surface}};
}

/* ── Status bar ────────────────────────────────────────────────── */
QStatusBar {
    background-color: {{surface}};
    border-top: 1px solid {{border}};
    color: {{mutedForeground}};
    padding: 2px 12px;
}
/* Qt draws a sunken frame around status bar widgets by default */
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: {{mutedForeground}};
    padding: 0 4px;
}

/* ── Collapsible sections (src/ui/common/collapsible_section.*) ── */
QToolButton#collapsibleSectionHeader {
    background-color: {{surface}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 6px 8px;
    text-align: left;
    font-weight: bold;
}
QToolButton#collapsibleSectionHeader:hover {
    background-color: {{currentLine}};
}
